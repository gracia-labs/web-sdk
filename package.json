{
    "name": "@gracia/web-sdk",
    "version": "0.0.66",
    "description": "Gracia — volumetric video SDK (player, app, Three.js, XR R3F, React hooks)",
    "type": "module",
    "exports": {
        "./core": {
            "types": "./dist/GraciaSDK.d.ts",
            "default": "./dist/GraciaSDK.eb870952c48d473b.js"
        },
        "./aio": {
            "default": "./dist/GraciaAIO.2fdb4e30c65556b7.js"
        },
        "./wasm": {
            "types": "./dist/GraciaWebCore.d.ts",
            "default": "./dist/GraciaWebCore.4c01ef1bfc2f4371.js"
        },
        "./manifest": "./dist/gracia-manifest.json",
        "./vite-plugin": {
            "types": "./dist/vite-plugin/index.d.ts",
            "default": "./dist/vite-plugin/index.mjs"
        }
    },
    "scripts": {
        "serve": "bun examples/plain/serve.mjs",
        "serve:vite": "bun run --cwd examples/react-vite dev"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "peerDependencies": {
        "@pmndrs/pointer-events": "6.6.30",
        "@react-three/fiber": "9.6.1",
        "@react-three/uikit": "1.0.74",
        "react": "19.2.7",
        "three": "0.185.1"
    },
    "peerDependenciesMeta": {
        "@pmndrs/pointer-events": {
            "optional": true
        },
        "@react-three/fiber": {
            "optional": true
        },
        "@react-three/uikit": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "three": {
            "optional": true
        }
    },
    "devDependencies": {
        "selfsigned": "5.5.0"
    },
    "keywords": [
        "webgpu",
        "gracia",
        "volumetric",
        "video",
        "gaussian-splatting",
        "webxr",
        "react"
    ],
    "sideEffects": false,
    "author": "Gracia Labs",
    "license": "SEE LICENSE IN LICENSE",
    "engines": {
        "node": ">=20"
    }
}
